#!/bin/sh
# Sync internet-detector per-interface instances with the current rrws_*
# interfaces: HTTP check through the interface, restart that interface when
# its check fails. The main "internet" instance is left untouched.
set -u

IFACES=$(uci -q show network 2>/dev/null |
	sed -n "s/^network\.\([^.=]*\)\.rrws_created='1'$/\1/p" |
	grep '^rrws_' | sort -u)
[ -n "$IFACES" ] || { echo "no rrws interfaces found" >&2; exit 1; }
# Normalise newlines to spaces: the membership test below expects " a b c ".
IFACES=$(echo $IFACES)

CURRENT=" $IFACES "

for n in $IFACES; do
	uci set "internet-detector.$n=instance"
	uci set "internet-detector.$n.enabled=1"
	uci set "internet-detector.$n.description=$n"
	uci set "internet-detector.$n.iface=$n"
	uci set "internet-detector.$n.check_type=2"
	uci -q delete "internet-detector.$n.urls"
	uci add_list "internet-detector.$n.urls=https://www.google.com"
	uci set "internet-detector.$n.interval_up=30"
	uci set "internet-detector.$n.interval_down=5"
	uci set "internet-detector.$n.connection_attempts=2"
	uci set "internet-detector.$n.connection_timeout=2"

	# Restart this interface when its internet check fails.
	uci set "internet-detector.$n.mod_network_restart_enabled=1"
	uci set "internet-detector.$n.mod_network_restart_dead_period=60"
	uci set "internet-detector.$n.mod_network_restart_attempts=0"
	uci set "internet-detector.$n.mod_network_restart_attempt_interval=60"
	uci set "internet-detector.$n.mod_network_restart_device_timeout=2"
	uci set "internet-detector.$n.mod_network_restart_disconnected_at_startup=1"
	uci -q delete "internet-detector.$n.mod_network_restart_ifaces"
	uci add_list "internet-detector.$n.mod_network_restart_ifaces=$n"

	# All other actions stay off: only the per-interface restart is wanted.
	uci set "internet-detector.$n.mod_led_control_enabled=0"
	uci set "internet-detector.$n.mod_reboot_enabled=0"
	uci set "internet-detector.$n.mod_modem_restart_enabled=0"
	uci set "internet-detector.$n.mod_public_ip_enabled=0"
	uci set "internet-detector.$n.mod_email_enabled=0"
	uci set "internet-detector.$n.mod_telegram_enabled=0"
	uci set "internet-detector.$n.mod_user_scripts_enabled=0"
	uci set "internet-detector.$n.mod_regular_script_enabled=0"
done

# Drop per-interface instances whose interface is gone. Keep the main
# "internet" instance and anything that is not an interface instance.
for s in $(uci -q show internet-detector 2>/dev/null |
	sed -n 's/^internet-detector\.\([^.=]*\)=instance$/\1/p'); do
	[ "$s" = "internet" ] && continue
	case "$CURRENT" in
		*" $s "*) ;;
		*) uci -q delete "internet-detector.$s" ;;
	esac
done

uci commit internet-detector || { echo "uci commit failed" >&2; exit 1; }
/etc/init.d/internet-detector restart >/dev/null 2>&1
sleep 2

echo "interfaces:"
for n in $IFACES; do
	echo "  $n -> $(uci -q get "internet-detector.$n.iface") restart=$(uci -q get "internet-detector.$n.mod_network_restart_enabled") ifaces=$(uci -q get "internet-detector.$n.mod_network_restart_ifaces")"
done
echo "processes: $(pgrep -f '^lua /usr/bin/internet-detector' | wc -l)"
